<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="gauzederPU" transaction-type="JTA">
        <!-- JNDI datasource registered by WildFly (see wildfly-config/configure-datasource.cli) -->
        <jta-data-source>java:/PostgresDS</jta-data-source>

        <class>com.ibanfr.gauzeder.infrastructure.persistence.HelloJpaEntity</class>

        <properties>
            <!-- Hibernate dialect for PostgreSQL 16 -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Schema management: validate in production, update for development convenience -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- SQL logging (disable in production) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Seed data loaded after schema creation -->
            <property name="jakarta.persistence.sql-load-script-source"
                      value="import.sql"/>
        </properties>
    </persistence-unit>
</persistence>
